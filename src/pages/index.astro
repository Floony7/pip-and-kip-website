---
import MainLayout from "../layouts/MainLayout.astro";
// import HeroSwiper from "../components/HeroSwiper.astro";
import ProductCard from "../components/ProductCard.astro";
import { featuredTeasers } from "../lib/content";
import { ORG_NAME, TAGLINE, SHOP_URL } from "../lib/constants";
import pipAndKip from "../img/kip.webp";
import lineOfBags from "../img/bag-line-up.jpg";
import pipAndKipGarden from "../img/pip-and-kip-garden.jpg";
// import { fetchEtsyProductSlides } from "../lib/etsyProducts";

// const heroSlides = await fetchEtsyProductSlides();
---

<MainLayout title="Home">
  <section class="hero" id="home">
    <div class="hero-copy">
      <p class="eyebrow">Give Gifts without destroying forests</p>
      <h1>Well crafted, reusable gift bags for all occasions</h1>
      <p class="hero-intro">
        A diverse collection of gift bags, made from materials saved from going
        to landfill. Make every occasion special.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={SHOP_URL}
          >Shop favourites <span>↗</span></a
        >
        <a class="text-link" href="#about"
          >The Pip and Kip story<span>↓</span></a
        >
      </div>
      <div class="hero-notes" aria-label="Store benefits">
        <span>✦ Thoughtfully sourced</span>
        <span>✦ Reusable</span>
        <span>✦ Made for gifting</span>
      </div>
    </div>
    <div
      class="hero-visual"
      aria-label="A collection of colourful Pip and Kip gifts"
    >
      <img
        src={lineOfBags.src}
        alt="A selection of beautifully wrapped gifts"
      />
      <!-- <div class="hero-sticker">
        <strong>Made to</strong><br />bring joy <span>♥</span>
      </div> -->
      <!-- <div class="hero-caption">
        <span>New</span><p>Fresh finds for brighter days</p>
      </div> -->
    </div>
  </section>

  <section class="products section-block" id="shop">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Currently In the Collection</p><h2>
          Elegant reusable gifting bags
        </h2>
      </div>
      <p>
        Our favourite pieces right now — full of colour, character and made to
        be shared and reused.
      </p>
    </div>
    <div class="product-grid" aria-label="Featured products">
      {featuredTeasers.map((t) => <ProductCard {...t} />)}
    </div>
  </section>

  <section class="about section-block">
    <div class="about-collage">
      <img
        class="about-main"
        src={pipAndKipGarden.src}
        alt="Independent shop owner arranging a bright display"
        loading="lazy"
      />
      <!-- <img
        class="about-detail"
        src="https://images.unsplash.com/photo-1523779917675-b6ed3a42a561?auto=format&fit=crop&w=700&q=85"
        alt="Colourful handmade details on a worktable"
        loading="lazy"
      /> -->
      <!-- <span class="about-mark">P + K</span> -->
    </div>
    <div class="about-copy" id="about">
      <p class="eyebrow">{ORG_NAME}</p>
      <h2>{TAGLINE}</h2>
      <p>
        Hi, I'm Bronwen and I'm passionate about making a positive difference to
        the planet by reducing the amount of waste and choosing more sustainable
        options. Even small changes can make a difference.
      </p>
      <p>
        Have you ever looked at the huge pile of wrapping paper on Boxing Day
        and thought "There must be a better option than using all this paper?"
      </p>
      <p>
        An idea came to me: make beautiful, reusable fabric gift bags that are
        eco-friendly, sustainable and reduce paper waste. Using these instead of
        paper is an easy way for each one of us to make a difference and be
        kinder to our planet. All profits from the sale of my bags will go to
        the cat rescue charity I support: K&K's Pawfect Haven.
      </p>
      <h3>Who are Pip and Kip?</h3>
      <p>
        Pip and Kip are our two rescue cats, Pippi and Kipling. Pippi comes all
        the way from New Zealand. She was born with a congenital eye defect and
        dwarfism, which both add to her cuteness.
      </p>
      <p>
        Kipling is a boy we lifted from the streets of Birmingham in the depths
        of winter. He stood out because he was the only kitten amongst all the
        stray cats. He's a sweet boy with the softest fur and he now has a
        forever home with us.
      </p>
      <p>
        All my proceeds from the Etsy store go straight to cat rescue efforts.
      </p>
      <!-- <a class="text-link" href="/about">Read the full story <span>↗</span></a> -->
      <div>
        <img
          class="Pip and Kip banner"
          src={pipAndKip.src}
          alt="Our two cats and the bags we produce."
          loading="lazy"
        />
      </div>
    </div>
  </section>
</MainLayout>
