---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSwiper from "../components/HeroSwiper.astro";
import ProductTeaserCard from "../components/ProductTeaserCard.astro";
import { featuredTeasers, homepageCards } from "../lib/content";
import { fetchEtsyProductSlides } from "../lib/etsyProducts";

const heroSlides = await fetchEtsyProductSlides();
---

<MainLayout title="Home">
  <HeroSwiper slides={heroSlides} />

  <section class="columns" aria-label="Home content columns">
    {
      homepageCards.map((card) => (
        <article class="card">
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))
    }
  </section>

  <section class="product-grid" aria-label="Featured products">
    {featuredTeasers.map((teaser) => <ProductTeaserCard {...teaser} />)}
  </section>
</MainLayout>
