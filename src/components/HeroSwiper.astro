---
import type { ProductSlide } from "../lib/etsyProducts";

type Props = {
  slides: ProductSlide[];
};

const { slides } = Astro.props;
---

{
  slides.length > 0 && (
    <section class="section hero" aria-label="Featured Etsy products">
      <swiper-container class="hero-swiper" init="false">
        {slides.map((slide) => (
          <swiper-slide>
            <article class="slide">
              <a class="slide-link" href={slide.url} aria-label={`View ${slide.name} on Etsy`}>
                <img src={slide.imageUrl} alt={slide.name} loading="lazy" />
                <div class="slide-copy">
                  <p class="eyebrow">{slide.source}</p>
                  <h2>{slide.name}</h2>
                  <p>{slide.description}</p>
                  <div class="slide-meta">
                    <strong>{slide.price}</strong>
                    {typeof slide.quantity === "number" && (
                      <span>{slide.quantity} available</span>
                    )}
                  </div>
                </div>
              </a>
            </article>
          </swiper-slide>
        ))}
      </swiper-container>
    </section>
  )
}

<style>
  .hero-swiper {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    min-height: 400px;
  }

  .slide-link {
    color: inherit;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
  }

  .slide img {
    aspect-ratio: 4 / 3;
    display: block;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    width: 100%;
  }

  .slide-copy {
    background: color-mix(in oklch, var(--ink) 72%, transparent);
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
  }

  .slide-copy .eyebrow,
  .slide-copy h2,
  .slide-copy p {
    margin: 0;
  }

  .slide-copy .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .slide-copy h2 {
    display: -webkit-box;
    font-size: 1.25rem;
    line-height: 1.15;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .slide-copy p:not(.eyebrow) {
    display: -webkit-box;
    font-size: 0.95rem;
    line-height: 1.4;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .slide-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .slide-meta span {
    font-size: 0.85rem;
  }
</style>

<script>
  import { register } from "swiper/element/bundle";

  // Register Swiper custom elements
  register();

  // Type definition for Swiper Element
  interface SwiperContainer extends HTMLElement {
    initialize: () => void;
  }

  const heroSwiper = document.querySelector(
    ".hero-swiper",
  ) as SwiperContainer | null;

  if (heroSwiper) {
    const swiperParams = {
      direction: "horizontal" as const,
      loop: true,
      slidesPerView: 1,
      breakpoints: {
        900: {
          slidesPerView: 3,
          spaceBetween: 18,
        },
      },
      autoplay: {
        delay: 3200,
        disableOnInteraction: false,
      },
      // Note: If you want to use pagination/navigation, ensure the elements exist
      // or let Swiper Element handle it by setting these to true or custom config.
      pagination: {
        clickable: true,
      },
      navigation: true,
    };

    // Assign parameters to the element
    Object.assign(heroSwiper, swiperParams);

    // Initialize the swiper
    heroSwiper.initialize();
  }
</script>
