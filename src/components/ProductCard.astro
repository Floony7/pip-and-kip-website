---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  title: string;
  description: string;
  price: string;
  href: string;
  imgPath: ImageMetadata;
  source?: string;
};

const {
  title,
  description,
  price,
  href,
  imgPath,
  source = "Small-batch favourite",
} = Astro.props;
---

<article class="card product-card">
  <a class="product-image" href={href} aria-label={`View ${title}`}>
    <Image
      src={imgPath}
      alt={title}
      format="webp"
      quality={80}
      width={600}
      widths={[320, 400, 480, 600, 800, 1200]}
      sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 900px) calc(46vw - 0.7rem), (max-width: 1304px) calc((92vw - 2.8rem) / 3), 385px"
      loading="lazy"
    />
    <span>{source}</span>
  </a>
  <div class="product-info">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="product-row">
      <strong>{price}</strong>
      <a href={href} aria-label={`View ${title}`}>View on Etsy <span>↗</span></a
      >
    </div>
  </div>
</article>
