---
import logo from "../img/pipandkip-logo.png";
import { SHOP_URL } from "../lib/constants";

type Props = {
  title: string;
};

const { title } = Astro.props as Props;
const path = Astro.url.pathname;
---

<header class="site-header">
  <nav class="site-nav">
    <a class="logo" href="/#home" aria-label="Love from Pip and Kip home">
      <span>With Love from</span>
      <img src={logo.src} alt={title} />
      <span>Pip & Kip</span>
    </a>
    <ul class="nav-links">
      <li>
        <a href="/#home" aria-current={path === "/" ? "page" : undefined}
          >Home</a
        >
      </li>
      <li><a href={SHOP_URL}>Shop</a></li>
      <li>
        <a href="/#about">About</a>
      </li>
    </ul>
    <a class="nav-cta" href="/#shop" target="_blank">Browse the collection</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--sky) 50%, transparent);
    backdrop-filter: blur(16px);
    /* border-bottom: 1px solid color-mix(in srgb, var(--navy) 10%, transparent); */
  }

  .site-nav {
    width: min(1200px, 92vw);
    margin: 0 auto;
    padding: 1.15rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    gap: 5px;
  }

  .logo img {
    display: block;
    height: 7rem;
    /* border-radius: 50%; */
    width: auto;
  }

  .logo span {
    font-family: "Hurricane", cursive;
    font-size: 2rem;
  }

  .site-nav li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    color: var(--navy);
    font-size: 0.9rem;
    font-weight: 650;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .site-nav li a:hover,
  .site-nav li a:focus-visible,
  .site-nav li a[aria-current="page"] {
    background: var(--sea-glass);
    color: var(--navy);
  }

  .site-nav li a:hover {
    transform: translateY(-1px);
  }

  .site-nav li a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }

  .nav-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--navy);
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .site-nav {
      padding: 0.7rem 0;
    }
    .site-nav ul {
      margin-left: auto;
    }
    .site-nav li:first-child {
      display: none;
    }
    .nav-cta {
      display: none;
    }
    .logo img {
      height: 2.2rem;
    }
  }
</style>
