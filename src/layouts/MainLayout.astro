---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { TAGLINE } from "../lib/constants";

type Props = {
  title?: string;
};
const { title } = Astro.props as Props;
const path = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const baseTitle = "Love from Pip and Kip";
const fullTitle = title ? `${baseTitle} | ${title}` : baseTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Thoughtful gifts, keepsakes and small-batch treasures from Love from Pip and Kip."
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <section class="site-shell">
      <Header title={title} />
      <main>
        <slot />
      </main>
      <footer>
        <span>&copy; {currentYear} {baseTitle}</span><span
          >Design by <a href="https://floony.dev" target="_blank"
            >Fred Lunjevich</a
          ></span
        ><span>{TAGLINE}</span>
      </footer>
    </section>
  </body>
</html>
